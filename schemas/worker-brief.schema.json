{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker brief",
  "type": "object",
  "required": [
    "owner",
    "task_ids",
    "base_revision",
    "paths",
    "resources",
    "source_references",
    "acceptance_ids",
    "required_checks"
  ],
  "properties": {
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "backend",
        "frontend",
        "qa-evidence",
        "security",
        "operations",
        "review-verify",
        "integrator"
      ]
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kind": {
            "enum": [
              "check",
              "test"
            ]
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "test_report": {
            "type": "object",
            "required": [
              "path",
              "format"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "junit",
                  "vitest",
                  "workflow-test"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "test"
                }
              }
            },
            "then": {
              "required": [
                "test_report"
              ]
            }
          }
        ]
      }
    },
    "host_capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  }
}
