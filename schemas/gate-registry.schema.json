{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate registry",
  "type": "object",
  "required": [
    "schema_version",
    "checks",
    "supported_suffixes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "supported_suffixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv",
          "stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stage": {
            "enum": [
              "fast",
              "integration",
              "delivery"
            ]
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "required": {
            "type": "boolean"
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "test_report": {
            "type": "object",
            "required": [
              "format",
              "glob"
            ]
          },
          "sonar": {
            "type": "object",
            "required": [
              "report"
            ]
          },
          "reuse": {
            "type": "object",
            "required": [
              "max_age_seconds",
              "toolchain_files"
            ],
            "properties": {
              "max_age_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "toolchain_files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum_memory_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "temporary_disk_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array"
    },
    "sonar": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        }
      }
    },
    "component_inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "component_dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "shared_input_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
