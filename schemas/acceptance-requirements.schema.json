{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance requirements",
  "type": "object",
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "enum": [
              "unit",
              "database",
              "transport",
              "browser",
              "client-ui",
              "system"
            ]
          },
          "independent_state": {
            "type": "boolean"
          },
          "recording_required": {
            "type": "boolean"
          },
          "assistive_technology": {
            "type": "string",
            "minLength": 1
          },
          "speech_required": {
            "type": "boolean"
          }
        }
      }
    },
    "feature_completion": {
      "type": "boolean"
    },
    "integration_owner": {
      "type": "string",
      "minLength": 1
    }
  }
}
